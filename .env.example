# بريد التواصل (اختياري لكن موصى به): يدخل ضمن "polite pool" في OpenAlex و Crossref لسرعة واستقرار أعلى
VITE_CONTACT_EMAIL=you@example.com

# عنوان واجهة ERIC. اتركه كما هو (يمر عبر Proxy/Rewrite لتفادي CORS)
VITE_ERIC_API_BASE=/api/eric


# ------------------------------------------------------------------
# ⚠️ المفاتيح السرية (Google / Gemini / OpenAI / DeepSeek ...) لا توضع هنا أبداً ولا بأي متغير يبدأ بـ VITE_
# لأنها ستظهر في كود المتصفح. مكانها: Cloudflare Pages ← Settings ← Variables and Secrets (نوع Secret)
# وللتجربة المحلية: ملف .dev.vars (انظر .dev.vars.example).
# ------------------------------------------------------------------
